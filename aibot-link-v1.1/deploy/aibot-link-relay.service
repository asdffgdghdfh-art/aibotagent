[Unit]
Description=Aibot Link Task Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aibotlink
Group=aibotlink
WorkingDirectory=/opt/aibot-link
EnvironmentFile=/etc/aibot-link/env
ExecStart=/usr/bin/python3 -m aibot_link.relay --host 127.0.0.1 --port 8787 --db /var/lib/aibot-link/relay.sqlite3
Restart=on-failure
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aibot-link
UMask=0077

[Install]
WantedBy=multi-user.target
