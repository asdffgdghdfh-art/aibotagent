# Replace aibot.example.com and install a valid TLS certificate using your
# existing Nginx/Certbot workflow. Do not expose the Python port directly.
server {
    listen 80;
    server_name aibot.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name aibot.example.com;
    ssl_certificate /etc/letsencrypt/live/aibot.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aibot.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 32k;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
